<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F5F7FA">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:layoutDirection="rtl">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تایید خودکار کارت به کارت" android:textSize="22sp" android:textStyle="bold" android:textColor="#172033" android:gravity="right" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="پیامک واریز بانک روی همین گوشی دریافت می‌شود و فقط پیامک‌های شبیه واریز بانکی، با امضای امن، برای سایت ارسال می‌شوند." android:textSize="13sp" android:textColor="#667085" android:lineSpacingExtra="4dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="آدرس سایت" android:textStyle="bold" android:textColor="#344054" />
        <EditText android:id="@+id/baseUrl" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:backgroundTint="#1D8EF0" android:inputType="textUri" android:singleLine="true" android:layoutDirection="ltr" android:textDirection="ltr" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="کلید API" android:textStyle="bold" android:textColor="#344054" />
        <EditText android:id="@+id/apiSecret" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:backgroundTint="#1D8EF0" android:inputType="textPassword" android:singleLine="true" android:layoutDirection="ltr" android:textDirection="ltr" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="فرستنده‌های مجاز پیامک بانک (اختیاری)" android:textStyle="bold" android:textColor="#344054" />
        <EditText android:id="@+id/senders" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:backgroundTint="#1D8EF0" android:hint="مثلاً BankMellat, 3000xxxx" android:singleLine="true" android:layoutDirection="ltr" android:textDirection="ltr" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="اگر خالی باشد، فقط پیامک‌هایی که متن واریز/بستانکار و مبلغ ریال یا تومان دارند ارسال می‌شوند." android:textSize="11sp" android:textColor="#8A94A3" />
        <Button android:id="@+id/saveBtn" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="22dp" android:text="ذخیره تنظیمات و فعال‌سازی" android:textAllCaps="false" />
        <Button android:id="@+id/testBtn" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="تست ارتباط امن با سایت" android:textAllCaps="false" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:padding="12dp" android:background="#FFFFFF" android:text="وضعیت: تنظیمات را ذخیره کنید." android:textSize="13sp" android:textColor="#475467" android:lineSpacingExtra="4dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="نکته: این اپ برای استفاده خصوصی روی گوشی دریافت‌کننده پیامک بانک طراحی شده است. برای کارکردن باید مجوز دریافت SMS را بدهید و Battery Optimization را برای اپ محدود نکنید." android:textSize="11sp" android:textColor="#8A94A3" android:lineSpacingExtra="3dp" />
    </LinearLayout>
</ScrollView>
